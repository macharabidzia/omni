QWEN_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
# For a prefetched local checkout mounted through docker-compose:
# QWEN_MODEL=/workspace/models/Qwen3-Omni-30B-A3B-Instruct
# Default single-GPU low-latency profile verified on 1x A100 80 GB.
QWEN_DEPLOY_CONFIG=/workspace/configs/qwen3_omni_single_a100_async_fastaudio.yaml
# For the multi-GPU upstream-style profile, override with:
# QWEN_DEPLOY_CONFIG=/workspace/configs/qwen3_omni_deploy.yaml
QWEN_PORT=8091
QWEN_VLLM_FLAGS=
VLLM_QWEN_REALTIME_SEGMENT_DURATION_S=2.0
HF_HUB_DISABLE_XET=1
HF_TOKEN=
QWEN_REALTIME_URL=ws://qwen3-omni:8091/v1/realtime
QWEN_CHAT_URL=http://qwen3-omni:8091/v1/chat/completions
QWEN_HEALTH_URL=http://qwen3-omni:8091/health
QWEN_TEXT_MAX_COMPLETION_TOKENS=64

LIVEKIT_URL=ws://185.62.58.164:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_ROOM=omni-room
LIVEKIT_AGENT_ID=omni-worker
LIVEKIT_BROWSER_IDENTITY_PREFIX=browser
LIVEKIT_CONTROL_TOPIC=omni.control
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_INPUT_SAMPLE_RATE=16000
LIVEKIT_OUTPUT_SAMPLE_RATE=48000
LIVEKIT_OUTPUT_FRAME_MS=20
LIVEKIT_OUTPUT_QUEUE_MS=60
LIVEKIT_PREROLL_FRAMES=8

GATEWAY_PORT=8080
CORS_ALLOW_ORIGINS=
VITE_GATEWAY_HTTP_URL=http://localhost:8080
WEB_PORT=3000

# RunPod overrides
RUNPOD_SSH_ALIAS=runpod-qwen
RUNPOD_SSH_HOST=195.26.233.65
RUNPOD_SSH_PORT=57403
RUNPOD_SSH_USER=root
RUNPOD_PROXY_WEB_URL=https://y977m2sllhl4w8-5173.proxy.runpod.net
RUNPOD_PROXY_GATEWAY_URL=https://<your-runpod-gateway-host>
RUNPOD_HTTP_GATEWAY_PORT=8000
RUNPOD_HTTP_WEB_PORT=5173
