HF_HOME=/workspace/.hf_home
TRANSFORMERS_CACHE=/workspace/.hf_home
OMNI_ENV_FILE=/workspace/.env

QWEN_MODEL=/workspace/omni/models/Qwen3-Omni-30B-A3B-Instruct
QWEN_DEPLOY_CONFIG=/workspace/omni/configs/qwen3_omni_single_a100_async_fastaudio.yaml
QWEN_HOST=127.0.0.1
QWEN_PORT=17091
QWEN_EXTERNAL_PORT=8091
QWEN_VLLM_FLAGS=
QWEN_INIT_TIMEOUT=1800
QWEN_STAGE_INIT_TIMEOUT=600
QWEN_SAFETENSORS_LOAD_STRATEGY=prefetch
VLLM_QWEN_REALTIME_SEGMENT_DURATION_S=2.0
PATCH_VLLM_ASYNC_REALTIME=1
QWEN_REALTIME_URL=ws://127.0.0.1:17091/v1/realtime
QWEN_CHAT_URL=http://127.0.0.1:17091/v1/chat/completions
QWEN_AUDIO_BACKEND=realtime
QWEN_AUDIO_INPUT_SAMPLE_RATE=16000
QWEN_AUDIO_OUTPUT_SAMPLE_RATE=24000
QWEN_HEALTH_URL=http://127.0.0.1:17091/health
QWEN_TEXT_MAX_COMPLETION_TOKENS=64
HF_HUB_DISABLE_XET=1
HF_TOKEN=

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=17080
GATEWAY_EXTERNAL_PORT=8080
CORS_ALLOW_ORIGINS='["http://127.0.0.1:17070","http://localhost:17070","https://<PUBLIC_IPADDR>:<VAST_TCP_PORT_3000>"]'

LIVEKIT_URL=ws://185.62.58.164:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_ROOM=omni-room
LIVEKIT_AGENT_ID=omni-worker
LIVEKIT_BROWSER_IDENTITY_PREFIX=browser
LIVEKIT_CONTROL_TOPIC=omni.control
LIVEKIT_TOKEN_TTL_SECONDS=3600
LIVEKIT_INPUT_SAMPLE_RATE=48000
LIVEKIT_OUTPUT_SAMPLE_RATE=48000
LIVEKIT_OUTPUT_FRAME_MS=20
LIVEKIT_OUTPUT_QUEUE_MS=40
LIVEKIT_PREROLL_FRAMES=1

WEB_HOST=127.0.0.1
WEB_PORT=17070
WEB_EXTERNAL_PORT=3000
VITE_GATEWAY_HTTP_URL=
VITE_DEV_PROXY_HTTP_TARGET=http://127.0.0.1:17080

ENABLE_HTTPS=true
ENABLE_AUTH=true

QWEN_DEBUG_RAW_EVENTS=false
QWEN_REQUEST_TIMEOUT_SECONDS=30
QWEN_RESPONSE_TIMEOUT_SECONDS=90
